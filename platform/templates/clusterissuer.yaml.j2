apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata: {name: kafka-acme}
spec:
  acme:
    server: {{ acme_server }}
    email: {{ acme_email }}
    privateKeySecretRef: {name: kafka-acme-account}
    solvers:
      - selector:
          dnsZones: ["{{ dns_zone }}"]
        dns01:
          route53:
            region: {{ aws_region }}
            hostedZoneID: {{ route53_hosted_zone_id }}
            accessKeyIDSecretRef: {name: aws-route53, key: access-key-id}
            secretAccessKeySecretRef: {name: aws-route53, key: secret-access-key}
